{
  "name": "term-assistant",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "21" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Administrationsvy", "onAutoForward": "openBrowser" }
  },
  "containerEnv": {
    "TX_BASE_URL": "https://tx-nordics.fhir.org/fhir",
    "TX_LANGUAGE": "sv",
    "FHIR_VERSION": "R4",
    "FHIR_VALIDATOR_JAR": "/home/vscode/.fhir/validator_cli.jar",
    "TERM_DEV_USERS": "anna,bertil"
  },
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "API-nyckel för Claude (AI-granskning och --ai vid inläsning). Lämna tomt om du inte vill använda AI.",
      "documentationUrl": "https://console.anthropic.com/settings/keys"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
