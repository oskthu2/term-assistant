{
  "name": "term-assistant",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [
    8000,
    8001,
    8080
  ],
  "portsAttributes": {
    "8000": {
      "label": "Administrationsverktyget (inläsningstjänsten)",
      "onAutoForward": "openBrowser"
    },
    "8001": {
      "label": "Terminologiassistenten (MCP-webb)",
      "onAutoForward": "openBrowser"
    },
    "8080": {
      "label": "Mockad terminologitjänst (HAPI)",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "TX_BASE_URL": "http://localhost:8080/fhir",
    "TX_LANGUAGE": "sv",
    "FHIR_VERSION": "R4",
    "FHIR_VALIDATOR_JAR": "/home/vscode/.fhir/validator_cli.jar",
    "TERM_DEV_USERS": "anna,bertil"
  },
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "API-nyckel för Claude (demo-klienten för MCP-servern och AI-granskning vid inläsning). Lämna tomt om du inte vill använda AI.",
      "documentationUrl": "https://console.anthropic.com/settings/keys"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}
