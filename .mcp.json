{
  "mcpServers": {
    "term-assistant": {
      "command": "python3",
      "args": ["-m", "term_assistant.cli", "mcp"],
      "env": {
        "PYTHONPATH": "src",
        "TX_BASE_URL": "https://tx-nordics.fhir.org/fhir",
        "TX_LANGUAGE": "sv",
        "TERM_REGISTRY": "registry.json"
      }
    }
  }
}
