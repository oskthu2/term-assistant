{
  "mcpServers": {
    "term-mcp": {
      "command": "python3",
      "args": [
        "-m",
        "term_mcp.server"
      ],
      "env": {
        "PYTHONPATH": "mcp-server/src",
        "TX_BASE_URL": "https://tx-nordics.fhir.org/fhir",
        "TX_LANGUAGE": "sv",
        "TX_SNOMED_EDITION": "se"
      }
    }
  }
}
